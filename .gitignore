# Dependencies — reinstalled via npm ci
node_modules/
server/node_modules/

# Build output — regenerated by `npm run build`
dist/
server/public/

# Databases — large, live on the server's persistent volume (/data),
# never committed to git. Copied up separately via scp.
*.db
*.db-wal
*.db-shm
*.db.bak
*.db.bak.*
*.db.*
server/_backups/

# Secrets
.env
.env.*

# Caches
server/nav-index.cache.json

# Lexicon Admin backups — timestamped snapshots taken automatically on every
# save (see server.js's Lexicon Admin section); local safety net, not source.
server/lexicon/.backups/

# FUSE artifacts — leftover ".fuse_hiddenXXXXXXXX" files from a mounted
# folder holding a deleted-but-open file handle. Harmless junk, never source
# (2026-08-18: 9 of these got committed by mistake — see git log — because
# this pattern wasn't ignored yet).
.fuse_hidden*

# OS / editor
.DS_Store
.vscode/
.idea/
vite.config.js.timestamp-*.mjs

# Python bytecode cache — machine/interpreter-specific, never source.
__pycache__/
*.pyc

# One-off ingestion payloads and reference/backup artifacts — these are
# intermediate inputs to a single ingest run (already consumed into
# corpus.db, which is the real source of truth per the DB rule above), not
# reusable source. The ingest_*.py SCRIPTS themselves are still committed —
# only their large generated JSON payloads and scratch backups are excluded.
server/*_import.json
server/*_import.part*.json
server/*_import_AUDIT.json
server/*_reference.json
server/*_stale_backup_*.json
server/kahana_*.pdf
server/stein_*.pdf

# Stray file from a broken sqlite URI-open attempt (literal filename
# "corpus.db?immutable=1", not a real corpus.db) — harmless junk, never source.
server/corpus.db?immutable=1
