{
 "verses": {
  "1:0": {
   "heb": "קטע שלישי טור ראשון"
  },
  "1:1": {
   "heb": "... לטמא אתם ו... אתם"
  },
  "1:2": {
   "heb": "... בנתיכם לבניהם."
  },
  "1:3": {
   "heb": "... ורעות רבות תמצאנה אתכם, וכל"
  },
  "1:4": {
   "heb": "... איש האלהים"
  },
  "1:5": {
   "heb": "... ... מכם, והייתם לאכלה"
  },
  "1:6": {
   "heb": "... מקצה הארץ ועד קצה הארץ. ויניע אתכם"
  },
  "1:7": {
   "heb": "... וגם לשחת, ולמעל"
  },
  "1:8": {
   "heb": "... יהוה אלהיכם, באו עליכם"
  },
  "1:9": {
   "heb": "... כל הגוים אשר"
  },
  "1:10": {
   "heb": "... כאשר עשיתם"
  },
  "1:11": {
   "heb": "... אשר משלו בכם"
  },
  "1:12": {
   "heb": "... ..."
  },
  "1:13": {
   "heb": "... להיות לו"
  },
  "1:14": {
   "heb": "... ... ..."
  },
  "1:15": {
   "heb": "... ... ..."
  },
  "3:0": {
   "heb": "קטעים שלישי טור שלישי ורביעי"
  },
  "3:1": {
   "heb": "ויוצא ..."
  },
  "3:2": {
   "heb": "ובעצם היום הזה ..."
  },
  "3:3": {
   "heb": "ונשמע אל משה ..."
  },
  "3:4": {
   "heb": "איש צדיק וגדול ... שרי אלפים, שרי"
  },
  "3:5": {
   "heb": "מאות, שרי חמשים ושרי עשרת ... לשפטים"
  },
  "3:6": {
   "heb": "לשטרים ..."
  },
  "3:7": {
   "heb": "ישמע ולא ..."
  },
  "3:8": {
   "heb": "ואל תירא, חזק ואמץ כי אתה תנחיל את העם הזה ... לא"
  },
  "3:9": {
   "heb": "ירפך ולא יעזבך. תחזקנה ידיך ..."
  },
  "3:10": {
   "heb": "לצאת לפני העם ..."
  },
  "4:0": {
   "heb": "קטע ששי טור ראשון"
  },
  "4:1": {
   "heb": "... כי ב... ..."
  },
  "4:2": {
   "heb": "... תפלה על חטאתינו"
  },
  "4:3": {
   "heb": "... ... אל תדמו לאחי אשר ירדו"
  },
  "4:4": {
   "heb": "... מעשיו לעולם, כי לדורותיה"
  },
  "4:5": {
   "heb": "... אשמתכם. אוי אחי עליכם"
  },
  "4:6": {
   "heb": "... ... וכאשר ידבר אב אל בנו"
  },
  "5:0": {
   "heb": "קטע ששי טור שני"
  },
  "5:1": {
   "heb": "... נסני וישימני ..."
  },
  "5:2": {
   "heb": "לעמד לפני אלהים ולפני ..."
  },
  "5:3": {
   "heb": "לבי, כי אלהים בחן ... ..."
  },
  "5:4": {
   "heb": "ויבחן. אוי לי ... ..."
  },
  "5:5": {
   "heb": "על ראשי ..."
  }
 },
