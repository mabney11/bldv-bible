// Open the freshly-written index DB for the post-build verification pass
const surfDb = new Database(path.join(__dirname, 'surface-index.db')); // readonly:true removed for the same device-bridge reason as src, above
surfDb.pragma('locking_mode = EXCLUSIVE'); // device-bridge WAL/mmap workaround, see project memory

// GET /api/surface?word=𐤏𐤋𐤌𐤔𐤌𐤓𐤕𐤉
// Returns the parsed metadata for one surface: root_paleo, strongs, components, etc.
app.get('/api/surface', (req, res) => {
    const word = (req.query.word || '').trim();
    if (!word) return res.status(400).json({ error: 'word param required' });
    const row = surfDb.prepare('SELECT * FROM token_surfaces WHERE word_raw = ?').get(word);
    if (!row) return res.status(404).json({ error: 'surface not found' });
    res.json({
        ...row,
        all_strongs: JSON.parse(row.all_strongs || '[]'),
        components:  JSON.parse(row.components),
    });
});

// GET /api/surface/verses?word=𐤏𐤋𐤌𐤔𐤌𐤓𐤕𐤉&offset=0&limit=25
// Returns paginated verse hits for one surface — all precomputed, O(1) lookup.
app.get('/api/surface/verses', (req, res) => {
    const word   = (req.query.word || '').trim();
    const offset = parseInt(req.query.offset, 10) || 0;
    const limit  = Math.min(parseInt(req.query.limit, 10) || 25, 50);
    if (!word) return res.status(400).json({ error: 'word param required' });

    const total = surfDb.prepare(
        'SELECT COUNT(*) AS n FROM surface_occurrences WHERE word_raw = ?'
    ).get(word)?.n || 0;

    const hits = surfDb.prepare(`
        SELECT book_id, chapter, verse, token_ordinal
        FROM surface_occurrences
        WHERE word_raw = ?
        ORDER BY book_id, chapter, verse, token_ordinal
        LIMIT ? OFFSET ?
    `).all(word, limit, offset);

    res.json({ word, total, offset, hasMore: total > offset + limit, hits });
});

// GET /api/root/by-strongs?sn=H4931
// Returns the canonical root entry from the index (root_paleo, occurrence count, surfaces).
app.get('/api/root/by-strongs', (req, res) => {
    const sn = ('H' + (req.query.sn || '').replace(/^H+/, '')).trim();
    if (sn === 'H') return res.status(400).json({ error: 'sn param required' });

    const surfaces = surfDb.prepare(`
        SELECT word_raw, rendered_paleo, root_paleo, pos, morph, components,
               (SELECT COUNT(*) FROM surface_occurrences WHERE word_raw = ts.word_raw) AS count
        FROM token_surfaces ts
        WHERE strongs = ? OR all_strongs LIKE ?
        ORDER BY count DESC
    `).all(sn, '%' + sn + '%');

    if (!surfaces.length) return res.status(404).json({ error: 'no surfaces for ' + sn });

    const root_paleo = surfaces[0].root_paleo;
    const total = surfaces.reduce((a, s) => a + (s.count || 0), 0);

    res.json({
        sn,
        root_paleo,
        total,
        surfaces: surfaces.map(s => ({
            ...s,
            components: JSON.parse(s.components),
            count: s.count,
        })),
    });
});

