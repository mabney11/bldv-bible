# Databases — these live on the Fly Volume (/data) and are uploaded
# separately via `fly ssh sftp put`, never baked into the image.
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db.bak

# Dependencies — installed fresh inside each build stage.
node_modules
server/node_modules

# Build output — regenerated by the frontend-build stage.
dist
server/public

# VCS / editor
.git
.gitignore
.vscode
.idea

# Offline-only source material — not needed at runtime, large, slows builds.
refs.txt
tree.txt
proj.txt
novel-english-bible.pdf
out_sefaria.jsonl
grc.clean.jsonl
works.geez.json
books.geez.json
manifest.json
sources.json
json
lexicon-audit
__pycache__
*.pyc
scripts
tests

# Misc large text/log artifacts sitting at repo root and in server/ from
# prior data work (align-report*.txt, amb*.txt, audit.txt, etc), plus docs.
*.txt
*.md
